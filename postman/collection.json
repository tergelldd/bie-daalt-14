      "item": [
        {
          "name": "Get All Posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 1s\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test(\"Response is array\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"First post has required fields\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json[0]).to.have.property(\"id\");",
                  "    pm.expect(json[0]).to.have.property(\"title\");",
                  "    pm.expect(json[0]).to.have.property(\"body\");",
                  "    pm.expect(json[0]).to.have.property(\"userId\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", () => {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
